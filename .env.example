# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_TRANSLATE_API_KEY: Google Cloud Translation API key (official, paid
# after the free tier). Used as the fallback when the free endpoint fails or is slow.
GOOGLE_TRANSLATE_API_KEY=""

# Live-caption translators are tried in this order:
#   1. "gtx"          — free, unofficial translate.googleapis.com endpoint (no key).
#                       Can be throttled/blocked anytime.
#   2. "google-cloud" — official Cloud Translation API (needs GOOGLE_TRANSLATE_API_KEY).
#   3. Gemini         — last resort (needs GEMINI_API_KEY).
# Errors, quota/rate-limit/bad-key responses, or answers slower than 2.5 s move on to the
# next one; quota errors and slow answers bench a provider for 10 minutes.
# MT_PROVIDER: set to "google-cloud" to try the paid API first instead. Leave unset for the default.
# MT_PROVIDER="google-cloud"

# REFINE_WITH_GEMINI: after a sentence is final, quietly replace the fast
# translation with a context-aware Gemini one. Never delays the first caption.
# Set to "false" to keep the fast translation as-is.
# REFINE_WITH_GEMINI="true"

# GEMINI_MODEL: model used for refinement (and the no-MT fallback).
# GEMINI_MODEL="gemini-4-hydrogen"

# --- Scaling and cost controls (all optional; change them in AI Studio's environment
# --- variables, no rebuild needed) ---

# Daily spending guards for the paid services. When a guard is used up, that service is skipped
# until midnight UTC and captions continue on the free translator. 0 means unlimited.
# CLOUD_TRANSLATE_DAILY_CHARS: characters sent to Cloud Translation per day (default 1000000,
# roughly $20 at list price; check current pricing).
# CLOUD_TRANSLATE_DAILY_CHARS=1000000
# GEMINI_DAILY_CALLS: Gemini calls per day, for the fallback translator and the clean-up pass
# (default 5000).
# GEMINI_DAILY_CALLS=5000

# How many proxies sit in front of this server and can be trusted to report the real visitor
# address (default 1, Cloud Run's front end). The "[usage]" log line shows forwardedEntries: if
# ordinary requests normally carry 2 entries, there is an extra proxy, so set this to 2.
# Too low and every visitor looks like the same address and shares one rate limit.
# TRUST_PROXY_HOPS=1

# Rate limits per minute: per browser tab, and per address (a multiple of the per-tab limit,
# as a backstop against tabs that fake new IDs).
# RATE_LIMIT_MT_PER_SESSION=900
# RATE_LIMIT_REFINE_PER_SESSION=60
# RATE_LIMIT_IP_MULTIPLIER=10
