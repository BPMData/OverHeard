# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_TRANSLATE_API_KEY: Google Cloud Translation API key (official, paid
# after the free tier). Used for live captions when it's the primary provider,
# and as a fallback otherwise.
GOOGLE_TRANSLATE_API_KEY=""

# MT_PROVIDER: which live-caption translator to try first.
#   "google-cloud" — default when GOOGLE_TRANSLATE_API_KEY is set.
#   "gtx"          — free, unofficial translate.googleapis.com endpoint (no key).
#                    Default when no key is set. Can be throttled/blocked anytime.
# Whatever isn't primary is used as a fallback (then Gemini as a last resort).
# Quota, rate-limit or bad-key errors bench a provider for 10 minutes.
# MT_PROVIDER="gtx"

# REFINE_WITH_GEMINI: after a sentence is final, quietly replace the fast
# translation with a context-aware Gemini one. Never delays the first caption.
# Set to "false" to keep the fast translation as-is.
# REFINE_WITH_GEMINI="true"

# GEMINI_MODEL: model used for refinement (and the no-MT fallback).
# GEMINI_MODEL="gemini-4-hydrogen"
